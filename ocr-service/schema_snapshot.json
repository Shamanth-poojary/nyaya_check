    "ReadabilityEntry": {
      "description": "Qualitative readability flag for one classified field.\n\nCombination heuristic (documented in app/visual/contrast.py):\n  hard_to_read if contrast.bucket == \"low\"\n               OR (contrast.bucket == \"medium\" AND ratioToNetQuantity < 0.5)\n  readable otherwise.\nThis is a HEURISTIC SIGNAL, not a certified measurement.  The Phase 03\nrules engine should treat \"hard_to_read\" as a soft signal, not a hard fail.",
      "properties": {
        "field": {
          "title": "Field",
          "type": "string"
        },
        "readability": {
          "title": "Readability",
          "type": "string"
        },
        "reason": {
