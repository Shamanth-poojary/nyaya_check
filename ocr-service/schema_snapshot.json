    "PrincipalDisplayPanel": {
      "description": "Heuristic identification of the Principal Display Panel image.\n\nFor multi-image submissions: the sourceImage that contributed the most of\n{commodity, netQuantity, mrp} is identified as the likely PDP.\nFor single-image submissions: trivially identified as the only image.\nisHeuristic is always True -- this is an inference from field-source tags,\nnot from photo metadata (there is none).",
      "properties": {
        "likelySourceImage": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Likelysourceimage"
        },
        "isHeuristic": {
          "default": true,
          "title": "Isheuristic",
          "type": "boolean"
        },
        "note": {
          "default": "",
          "title": "Note",
          "type": "string"
        }
      },
      "title": "PrincipalDisplayPanel",
      "type": "object"
    },
    "QuantityClearance": {
      "description": "Whitespace clearance around the net quantity declaration.\n\nEach ratio = distance-to-nearest-neighbor-in-pixels / netQuantity-bbox-height.\nNeighbor = nearest other rawOCR bbox in that cardinal direction, or the\nimage edge if no text is closer.  These are pixel ratios in the original\nphoto's coordinate space; they do NOT represent physical mm clearances.\nNone means the net quantity field has no bbox and clearance cannot be computed.",
      "properties": {
        "aboveRatio": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Aboveratio"
        },
        "belowRatio": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Belowratio"
        },
        "leftRatio": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Leftratio"
        },
        "rightRatio": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rightratio"
        },
        "note": {
          "default": "",
          "title": "Note",
          "type": "string"
        }
      },
      "title": "QuantityClearance",
      "type": "object"
    },
