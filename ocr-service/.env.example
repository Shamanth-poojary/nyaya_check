# Legal Metrology OCR / Extraction Service Configuration
# Copy this file to .env to override default configuration values.

# Request & file payload limits
MAX_IMAGES_PER_REQUEST=10
MAX_FILE_SIZE_MB=15
ALLOWED_CONTENT_TYPES=["image/jpeg", "image/png", "image/webp"]

# Pipeline defaults
PREPROCESS_ENABLED_DEFAULT=false

# Authentication (None / empty = auth disabled; set string to enforce X-API-Key header)
API_KEY=

# CORS configuration (JSON array of permitted origins)
CORS_ALLOWED_ORIGINS=["http://localhost:3000", "http://localhost:5173", "http://127.0.0.1:3000", "http://127.0.0.1:5173"]

# Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Production Gunicorn worker concurrency (used by Docker container)
WEB_CONCURRENCY=2
