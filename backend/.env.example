# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (External PostgreSQL)
DATABASE_URL=postgresql://YOUR_DB_USER:YOUR_DB_PASSWORD@YOUR_DB_HOST:5432/YOUR_DB_NAME?sslmode=require

# Frontend Client Origin (for CORS)
FRONTEND_URL=http://localhost:3000

# Authentication & JWT Configuration
JWT_SECRET=YOUR_JWT_SECRET_KEY
JWT_EXPIRES_IN=24h

# Cookie Configuration
COOKIE_NAME=auth_token
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=

# Default Admin Credentials (Auto-seeded on backend start)
ADMIN_NAME=your Admin User
ADMIN_EMAIL=your admin email
ADMIN_PASSWORD=your admin password